PORT=5000
NODE_ENV=development

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/elektronikachi?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/elektronikachi?schema=public"

JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

